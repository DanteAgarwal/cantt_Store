# ============================================================
# apps/api — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, port 6543) — used for all runtime queries
DATABASE_URL="postgresql://postgres.<project>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used ONLY by prisma migrate
DIRECT_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"

# --- Supabase Auth / Storage ---
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"
SUPABASE_JWT_SECRET="<your-jwt-secret>"

# --- Supabase Storage Buckets ---
SUPABASE_BUCKET_PRODUCT_IMAGES="product-images"
SUPABASE_BUCKET_BANNERS="banners"
SUPABASE_BUCKET_CMS="cms-media"
SUPABASE_BUCKET_AVATARS="avatars"

# --- App settings ---
PORT=3001
NODE_ENV="development"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# --- Email (Resend or SendGrid — pick one at Phase 2) ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="orders@yourstore.com"

# --- Upstash Redis (CONDITIONAL — only add once NFR-4 trigger fires) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Payment Gateway (Phase 2 — pending merchant account) ---
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
