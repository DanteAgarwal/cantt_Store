# ============================================================
# apps/web — Environment Variables
# ============================================================
# Copy to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are safe to expose in the browser bundle.
# ============================================================

# Backend API URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api/v1"

# Supabase — public vars (safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"

# On-demand ISR revalidation secret
# Must match REVALIDATE_SECRET set in apps/api .env
REVALIDATE_SECRET="<random-secret-string>"
